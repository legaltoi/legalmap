# ==========================================
# CONFIGURATION ENVIRONNEMENT LEGALMAPS
# ==========================================

# 1. Supabase Realtime (Pure WebSocket Broadcast - 0 persistance)
NEXT_PUBLIC_SUPABASE_URL=https://elpnscywkpsljrxkluij.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_iPZOlCk9Rj1T6kWLBz8hbg_Od7Nt3Tz
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_iPZOlCk9Rj1T6kWLBz8hbg_Od7Nt3Tz

# 2. Clé PUBLIQUE de vérification du cortège (Ed25519)
# La clé PRIVÉE ne doit JAMAIS figurer dans ce fichier ni être commitée.
# Elle réside uniquement dans l'URL de l'organisateur (/admin#priv=...)
# Générée via : node scripts/generate-keys.js
NEXT_PUBLIC_ADMIN_VERIFY_KEY=909b69715acf5dbc959e1e23c00bdf8868d694214b8cf5d5751f28a8867dce4c

# 3. Token GitHub PAT (Optionnel pour auto-commit dans nantes.json depuis la console admin)
# Droits requis : contents:write sur le dépôt legaltoi/legalmap
# NEXT_PUBLIC_GITHUB_TOKEN=github_pat_...

# 4. Flux Social X / Twitter (Optionnel - Fallback dynamique inclus si non configuré)
# Endpoint proxy ou API REST retournant les derniers tweets #ManifNantes
# NEXT_PUBLIC_SOCIAL_FEED_API_URL=https://api.example.com/feed

# 5. Flux Météo & Vent en Temps Réel (Optionnel - Open-Meteo / Météo-France actif par défaut)
# Permet de brancher un proxy WeatherNext 3 ou station météo locale
# NEXT_PUBLIC_WEATHER_API_URL=https://api.example.com/weather


